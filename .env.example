# ============================================================
# n8n-lab — Environment Configuration Template
# ============================================================
# Copy this file to .env and provide environment-specific values.
# Never commit the actual .env file.
#
# Secrets are managed separately through Docker secrets.
# See docker-compose.yml for the secret file locations.
# ============================================================

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n

# n8n public URLs
# N8N_HOST must contain the hostname only, without https://
N8N_HOST=your-n8n-hostname.example.com
N8N_WEBHOOK_URL=https://your-n8n-hostname.example.com
N8N_EDITOR_BASE_URL=https://your-n8n-hostname.example.com
N8N_PUBLIC_API_BASE_URL=https://your-n8n-hostname.example.com

