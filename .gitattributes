# Normalize all text files
* text=auto

# Force Linux line endings
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.tar.gz binary
*.gz binary