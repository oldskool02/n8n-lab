services:

  postgres:
    image: pgvector/pgvector:pg16
    restart: unless-stopped
    secrets:
      - postgres_password
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
    ports:
      - "127.0.0.1:5433:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - n8n_internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER}"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: redis-server --appendonly yes
    volumes:
      - redis_data:/data
    networks:
      - n8n_internal

  n8n:
    image: n8nio/n8n:1.107.4
    # build:
    #   context: .
    #   dockerfile: Dockerfile.n8n
    # command: node /usr/local/lib/node_modules/n8n/bin/n8n start
    user: "node"
    env_file:
      - .env
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_started
    ports:
      - "127.0.0.1:5678:5678"
    environment:
      DB_POSTGRESDB_MIGRATION_RUN: "true"
      DB_TYPE: postgresdb
      DB_POSTGRESDB_HOST: postgres
      DB_POSTGRESDB_PORT: 5432
      DB_POSTGRESDB_DATABASE: n8n
      DB_POSTGRESDB_USER: n8n
      DB_POSTGRESDB_PASSWORD_FILE: /run/secrets/postgres_password

      N8N_PROTOCOL: https
      N8N_SECURE_COOKIE: "true"
      NODE_ENV: production
      N8N_COMMUNITY_PACKAGES_ENABLED: "true"
      N8N_CUSTOM_EXTENSIONS: "/home/node/.n8n/custom"
      N8N_ENCRYPTION_KEY_FILE: /run/secrets/n8n_encryption_key
      N8N_HOST: oldskooln8n.xyz
      N8N_WEBHOOK_URL: https://oldskooln8n.xyz
      N8N_EDITOR_BASE_URL: https://oldskooln8n.xyz
      N8N_TRUST_PROXY: "true"
      N8N_CONCURRENCY_PRODUCTION_LIMIT: "2"
      N8N_USER_MANAGEMENT_DISABLED: "false"
      N8N_DIAGNOSTICS_ENABLED: "false"
      N8N_RUNNERS_ENABLED: "true"

      OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS: "false"

      GOOGLE_APPLICATION_CREDENTIALS: /run/secrets/google_service_account

      EXECUTIONS_MODE: queue
      QUEUE_BULL_REDIS_HOST: redis
      QUEUE_BULL_REDIS_PORT: 6379
      QUEUE_HEALTH_CHECK_ACTIVE: "true"
    volumes:
      - n8n_data:/home/node/.n8n
      - /opt/n8n-lab/import:/import
      - /opt/secrets:/run/secrets:ro
    networks:
      - n8n_internal

  n8n-worker:
    # build:
    #   context: .
    #   dockerfile: Dockerfile.n8n
    image: n8nio/n8n:1.107.4
    command: worker
    env_file:
      - .env
    user: "node"
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_started
    # secrets:
    #   - n8n_encryption_key
    #   - postgres_password
    #   - google_service_account
    # secrets:
    #   - source: n8n_encryption_key
    #     target: n8n_encryption_key
    #     uid: "1000"
    #     gid: "1000"
    #     mode: 0400

    #   - source: postgres_password
    #     target: postgres_password
    #     uid: "1000"
    #     gid: "1000"
    #     mode: 0400

    #   - source: google_service_account
    #     target: google_service_account
    #     uid: "1000"
    #     gid: "1000"
    #     mode: 0400

    environment:
      DB_TYPE: postgresdb
      DB_POSTGRESDB_HOST: postgres
      DB_POSTGRESDB_PORT: 5432
      DB_POSTGRESDB_DATABASE: n8n
      DB_POSTGRESDB_USER: n8n
      # DB_POSTGRESDB_PASSWORD_FILE: /run/secrets/postgres_password
      DB_POSTGRESDB_PASSWORD: 'Marie1964'

      N8N_PROTOCOL: https
      N8N_SECURE_COOKIE: "true"
      NODE_ENV: production
      N8N_COMMUNITY_PACKAGES_ENABLED: "true"
      N8N_CUSTOM_EXTENSIONS: "/home/node/.n8n/custom"
      N8N_ENCRYPTION_KEY_FILE: /run/secrets/n8n_encryption_key
      N8N_CONCURRENCY_PRODUCTION_LIMIT: "2"
      N8N_RUNNERS_ENABLED: "true"
      OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS: "true"

      GOOGLE_APPLICATION_CREDENTIALS: /run/secrets/google_service_account


      EXECUTIONS_MODE: queue
      QUEUE_BULL_REDIS_HOST: redis
      QUEUE_BULL_REDIS_PORT: 6379
      QUEUE_HEALTH_CHECK_ACTIVE: "true"
    volumes:
      - n8n_data:/home/node/.n8n
      - /opt/secrets:/run/secrets:ro
    networks:
      - n8n_internal

  # crm-backend:
  #   build: ./crm/backend
  #   # ports:
  #   #   - "8002:8002"
  #   restart: unless-stopped
  #   depends_on:
  #     postgres:
  #       condition: service_healthy
  #   secrets:
  #     - postgres_password
  #   environment:
  #     DB_HOST: postgres
  #     DB_NAME: crm
  #     DB_USER: ${POSTGRES_USER}
  #     DB_PASSWORD_FILE: /run/secrets/postgres_password
  #   volumes:
  #     - crm_documents:/data/crm_documents
  #   networks:
  #     - n8n_internal

  chat-backend:
    build: ./chat-backend
    # ports:
    #   - "8001:8000"
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    secrets:
      - postgres_password
    environment:
      DB_HOST: postgres
      DB_NAME: ${POSTGRES_DB}
      DB_USER: ${POSTGRES_USER}
      # DB_PASSWORD_FILE: /run/secrets/postgres_password
      DB_POSTGRESDB_PASSWORD: 'Marie1964'
    networks:
      - n8n_internal

  # doc-engine:
  #   build: ./doc-engine
  #   # ports:
  #   #   - "8000:8000"
  #   restart: unless-stopped
  #   networks:
  #     - n8n_internal

  # python-fx:
  #   build: ./python-fx
  #   ports:
  #     - "5000:5000"
  #   restart: unless-stopped
  #   networks:
  #     - n8n_internal

  # recovery-api:
  #   build: ./recovery
  #   ports:
  #     - "5050:5050"
  #   restart: unless-stopped
  #   networks:
  #     - n8n_internal

  ollama:
    image: ollama/ollama
    restart: unless-stopped
    # ports:
    #   - "11434:11434"
    volumes:
      - ollama_data:/root/.ollama
    networks:
      - n8n_internal

  cloudflared:
    image: cloudflare/cloudflared:2024.12.0
    restart: unless-stopped
    command: tunnel --config /etc/cloudflared/config.yml run
    volumes:
      - /opt/n8n-lab/cloudflared:/etc/cloudflared
    networks:
      - n8n_internal

networks:
  n8n_internal:

volumes:
  postgres_data:
  n8n_data:
  redis_data:
  crm_documents:
  ollama_data:

secrets:
  postgres_password:
    file: /opt/secrets/postgres_password

  n8n_encryption_key:
    file: /opt/secrets/n8n_encryption_key

  google_service_account:
    file: /opt/secrets/service-account.json
