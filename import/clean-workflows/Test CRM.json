      "parameters": {
        "jsCode": "const grouped = {};\n\nfor (const item of items) {\n  const email = item.json.user_email;\n\n  if (!grouped[email]) {\n    grouped[email] = [];\n  }\n\n  grouped[email].push(item.json);\n}\n\nreturn Object.keys(grouped).map(email => {\n  return {\n    json: {\n      user_email: email,\n      follow_ups: grouped[email]\n    }\n  };\n});"
