    {
      "parameters": {
        "jsCode": "const followUps = $json.follow_ups;\n\nlet html = `<h2>📞 Daily Follow-ups</h2>`;\n\nfor (const f of followUps) {\n  const link = `http://localhost:3000/interactions/${f.id}`;\n\n  html += `\n    <div style=\"margin-bottom:15px;\">\n      <strong>${f.account_name}</strong><br/>\n      👤 ${f.contact_name}<br/>\n      📝 ${f.notes}<br/>\n      ⏰ Due: ${new Date(f.follow_up_date).toLocaleString()}<br/>\n      👉 <a href=\"${link}\">Open Interaction</a>\n    </div>\n  `;\n}\n\nreturn [{\n  json: {\n    user_email: $json.user_email,\n    html\n  }\n}];"
      },
