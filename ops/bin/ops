#!/usr/bin/env bash


set -Eeuo pipefail

OPS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly OPS_ROOT
export OPS_ROOT

# Global libraries
source "$OPS_ROOT/lib/config.sh"
source "$OPS_ROOT/lib/common.sh"
source "$OPS_ROOT/lib/print.sh"

# Global Constants
source "$OPS_ROOT/lib/constants.sh"

# Subsystems
source "$OPS_ROOT/lib/system.sh"
source "$OPS_ROOT/lib/docker.sh"

command="${1:-help}"
if (( $# > 0 ));
then
    shift
fi

command_file="$OPS_ROOT/commands/${command}.sh"

if [[ -f "$command_file" ]]
then
    source "$command_file"

    command_function="run_$command"

    "$command_function" "$@"

else
    error "Unknown command: $command"
    newline
    print_message "Try:"
    print_message "    ops help"

    exit "$EXIT_ERROR"

fi
