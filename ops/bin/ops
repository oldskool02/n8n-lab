#!/usr/bin/env bash

set -Eeuo pipefail

OPS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly OPS_ROOT
export OPS_ROOT

# Global libraries
source "$OPS_ROOT/lib/config.sh"
source "$OPS_ROOT/lib/common.sh"

# Subsystems
source "$OPS_ROOT/lib/system.sh"
source "$OPS_ROOT/lib/docker.sh"

COMMAND="${1:-}"

COMMAND_SCRIPT="$OPS_ROOT/commands/${COMMAND}.sh"

if [[ -f "$COMMAND_SCRIPT" ]]
then
    source "$COMMAND_SCRIPT"
else

    echo "Unknown command: $COMMAND"
    echo
    echo "Try:"
    echo "    ops version"

    exit 1

fi
