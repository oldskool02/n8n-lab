#!/usr/bin/env bash

set -Eeuo pipefail

OPS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly OPS_ROOT
export OPS_ROOT

# Global libraries
source "$OPS_ROOT/lib/config.sh"
source "$OPS_ROOT/lib/common.sh"

# Subsystems
source "$OPS_ROOT/lib/system.sh"
source "$OPS_ROOT/lib/docker.sh"

COMMAND="${1:-help}"
if (( $# > 0 ));
then
    shift
fi

COMMAND_FILE="$OPS_ROOT/commands/${COMMAND}.sh"

if [[ -f "$COMMAND_FILE" ]]
then
    source "$COMMAND_FILE"

    COMMAND_FUNCTION="run_$COMMAND"

    "$COMMAND_FUNCTION" "$@"

else
    echo "Unknown command: $COMMAND"
    echo
    echo "Try:"
    echo "    ops help"

    exit 1

fi
